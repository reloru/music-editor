{
  "name": "music-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mobile-first MP3/WAV editor that runs entirely in the browser, served from a Cloudflare Worker.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/generate-icons.mjs",
    "cf:dev": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260818.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.124.0"
  }
}
